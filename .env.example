# Copy to .env. Never commit the real .env.
# Google Gemini API key from https://aistudio.google.com/apikey
# (free tier available, no credit card required). Looks like: AIza...
GEMINI_API_KEY=
# LLM used for enrich/extract/repair (only on cache misses)
LLM_MODEL=gemini-3.8-flash
# Gemini's OpenAI-compatible endpoint (the SDK appends /chat/completions)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# auto = LLM when a key is present, else deterministic rules; rules = never call the LLM
PIPELINE_MODE=auto
# Optional overrides (defaults come from thresholds.json, written by `python eval/run_eval.py --tune`)
# HIT_THRESHOLD=0.9
# BORDERLINE_LOW=0.7
# CE_HIT_THRESHOLD=0.4
# DL_THRESHOLD=0.856
# CACHE_DB=cache.sqlite3
